model Image {
  id            String        @id @default(uuid())
  productId     String
  imageName     String?
  imageUrl      String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  height        Int           @default(0)
  imageCategory ImageCategory @default(PRODUCT)
  imageKey      String        @unique @default(dbgenerated("gen_random_uuid()"))
  mimeType      String        @default("unknown")
  size          Int           @default(0)
  width         Int           @default(0)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([productId, imageCategory])
}

enum ImageCategory {
  PRODUCT
  MALICIOUS
}
