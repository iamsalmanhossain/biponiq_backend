model Documentation {
  id                 String   @id @default(uuid())
  title              String   @unique // English title
  titleBn            String?  // Bangla title
  category           String
  descriptionSteps   String[] @db.Text // English steps
  descriptionStepsBn String[] @db.Text // Bangla steps
  isPublished        Boolean  @default(true)
  images             String[]
  redirectUrl        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("documentations")
}
