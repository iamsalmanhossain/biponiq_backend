model OrderItem {
  id            String         @id @default(uuid())
  orderId       String
  productId     String
  quantity      Int
  price         Float
  createdAt     DateTime       @default(now())
  vendorEarning VendorEarning?
  order         Order          @relation(fields: [orderId], references: [id])
  product       Product        @relation(fields: [productId], references: [id])

  @@map("order_items")
}
